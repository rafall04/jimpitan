# Purpose: Ignore generated local, secret, runtime, and deployment artifacts for the JIMPITAN workspace.
# Caller: Git, development tooling, test tooling, and release operators.
# Deps: Node.js, NestJS, Prisma, Docker Compose, Playwright/Vitest, coverage/build tools.
# MainFuncs: Prevents dependencies, generated builds, caches, local env files, runtime volumes, logs, uploads, exports, and test artifacts from entering version control.
# SideEffects: Hides matching files from normal git status output.

# Dependencies
node_modules/

# Build and generated output
dist/
build/
coverage/
.next/
.nuxt/
.cache/
*.tsbuildinfo

# Prisma generated client artifacts stay generated from prisma/schema.prisma.
.prisma/
node_modules/.prisma/

# Local environment files. Keep committed examples only.
.env
.env.*

# Runtime storage, Docker volume mounts, and generated exports/uploads.
/uploads/
/exports/
/storage/
/runtime/
/volumes/
/docker-data/
/postgres_data/
/redis_data/
/upload_data/
/export_data/
/backups/
*.dump
*.dump.gz
*.sql.gz

# Test, browser, screenshot, video, and trace artifacts.
playwright-report/
test-results/
blob-report/
playwright/.cache/
screenshots/
videos/
traces/
*.trace
*.webm
*.har
tmp/e2e/

# Package manager and application logs.
.npm-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Local agent/session state.
.superpowers/
