# Purpose: Example environment variables for the JIMPITAN NestJS API.
# Caller: Developers, Docker runtime, and deployment configuration.
# Deps: PostgreSQL, Redis, JWT secrets, Telegram, local storage, and optional S3-compatible storage.
# MainFuncs: Documents required environment variable names without real secrets.
# SideEffects: None.

NODE_ENV=development
APP_ENV=local
APP_NAME=JIMPITAN API
API_PORT=3001
API_PREFIX=api
API_VERSION=1
DATABASE_URL=postgresql://jimpitan:jimpitan@postgres:5432/jimpitan?schema=public
REDIS_URL=redis://redis:6379
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
JWT_ACCESS_SECRET=change-me-access-secret-min-32
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12
BOT_TOKEN=change-me
BOT_WEBHOOK_SECRET=change-me
BOT_WEBHOOK_URL=http://localhost:3001/api/v1/telegram/webhook
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
UPLOAD_STORAGE_PATH=/var/lib/jimpitan/uploads
EXPORT_STORAGE_PATH=/var/lib/jimpitan/exports
WORKER_QUEUES=notification-outbox,report-exports,telegram-delivery
WORKER_BATCH_SIZE=20
WORKER_POLL_INTERVAL_MS=5000
WORKER_STALE_JOB_MS=900000
WORKER_RUN_ONCE=false
WORKER_HEALTH_FILE=/tmp/jimpitan-worker-health
SWAGGER_ENABLED=true
