# Purpose: Example environment variables for the JIMPITAN Next.js frontend.
# Caller: Developers, Docker builds, and deployment configuration.
# Deps: apps/web/src/lib/env/env.ts.
# MainFuncs: Documents required API URL, app URL, and production cookie/proxy expectations.
# SideEffects: None.
# Public, browser-facing API origin (baked into the client bundle at build; used for image src,
# the CSV export href, and same-origin browser fetches). Behind a single domain this is the site URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:8080
# Optional server-only internal API origin for SSR/BFF/auth fetches. Set this when the public URL
# routes through an external edge (e.g. a Cloudflare tunnel) so server-to-server calls stay internal
# instead of hair-pinning out and back. Falls back to NEXT_PUBLIC_API_BASE_URL when unset.
# Example (Docker host-nginx deploy): API_INTERNAL_BASE_URL=http://api:3001/api/v1
# API_INTERNAL_BASE_URL=
