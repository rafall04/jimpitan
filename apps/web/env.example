# Purpose: Example environment variables for the JIMPITAN Next.js frontend.
# Caller: Developers, Docker builds, and deployment configuration.
# Deps: apps/web/src/lib/env/env.ts.
# MainFuncs: Documents required API URL, app URL, and production cookie/proxy expectations.
# SideEffects: None.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:8080
