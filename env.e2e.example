# Purpose: Local E2E environment example for deterministic Playwright runs.
# Caller: scripts/e2e-check.mjs and tests/e2e/support/env.ts.
# Deps: PostgreSQL test database, local API/web ports, and safe non-production credentials.
# MainFuncs: Documents required E2E runtime variables without production secrets.
# SideEffects: None.

E2E_BASE_URL=http://127.0.0.1:3100
E2E_API_BASE_URL=http://127.0.0.1:3101/api/v1
E2E_DATABASE_URL=postgresql://jimpitan:jimpitan@127.0.0.1:5432/jimpitan_e2e?schema=public
E2E_ADMIN_EMAIL=super-admin.e2e-mvp@e2e.local
E2E_ADMIN_PASSWORD=E2ePassword123!
E2E_BENDAHARA_EMAIL=bendahara.e2e-mvp@e2e.local
E2E_BENDAHARA_PASSWORD=E2ePassword123!
E2E_NAMESPACE=e2e-mvp
E2E_BCRYPT_ROUNDS=10
