# Purpose: Root example environment for Docker Compose deployment of JIMPITAN.
# Caller: compose.prod.yaml, compose.dev.yaml, deployment docs, and operators creating private env files.
# Deps: PostgreSQL, Redis, API, web, worker, Telegram, and storage settings.
# MainFuncs: Documents required variable names using non-secret placeholders.
# SideEffects: None.

POSTGRES_DB=jimpitan
POSTGRES_USER=jimpitan
POSTGRES_PASSWORD=replace-with-private-postgres-password
HTTP_PORT=80
APP_ENV_FILE=env.example

NODE_ENV=production
APP_ENV=production
APP_NAME=JIMPITAN API
API_PORT=3001
API_PREFIX=api
API_VERSION=1
DATABASE_URL=postgresql://jimpitan:replace-with-private-postgres-password@postgres:5432/jimpitan?schema=public
REDIS_URL=redis://redis:6379

LOG_LEVEL=info
TRUST_PROXY_HOPS=1
CORS_ALLOWED_ORIGINS=
SWAGGER_ENABLED=false

JWT_ACCESS_SECRET=replace-with-private-access-secret-min-32
JWT_REFRESH_SECRET=replace-with-private-refresh-secret-min-32
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12

BOT_TOKEN=replace-with-private-telegram-bot-token
BOT_WEBHOOK_SECRET=replace-with-private-telegram-secret
BOT_WEBHOOK_URL=https://example.com/api/v1/telegram/webhook

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
UPLOAD_STORAGE_PATH=/var/lib/jimpitan/uploads
EXPORT_STORAGE_PATH=/var/lib/jimpitan/exports

WORKER_QUEUES=notification-outbox,report-exports,telegram-delivery
WORKER_BATCH_SIZE=20
WORKER_POLL_INTERVAL_MS=5000
WORKER_STALE_JOB_MS=900000
WORKER_RUN_ONCE=false
WORKER_HEALTH_FILE=/tmp/jimpitan-worker-health

NEXT_PUBLIC_API_BASE_URL=https://example.com/api/v1
NEXT_PUBLIC_APP_URL=https://example.com
