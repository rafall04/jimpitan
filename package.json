{
  "x-doc": {
    "Purpose": "Root package manifest for the JIMPITAN backend and frontend workspace.",
    "Caller": "npm scripts, Docker builds, and local development commands.",
    "Deps": "NestJS, Nest testing utilities, Prisma, Next.js, React, Tailwind CSS, TypeScript, and runtime packages.",
    "MainFuncs": "Defines dependency versions plus backend, worker, frontend, first-admin bootstrap, Prisma, Docker config, import-scan, E2E, smoke, readiness, DI regression, and E2E start scripts.",
    "SideEffects": "npm install creates node_modules; build scripts create dist output."
  },
  "name": "jimpitan",
  "version": "0.1.0",
  "private": true,
  "description": "JIMPITAN RT financial management platform backend workspace.",
  "scripts": {
    "build:api": "tsc -p apps/api/tsconfig.build.json",
    "build:worker": "tsc -p apps/api/tsconfig.build.json",
    "build:web": "next build apps/web",
    "start:api:e2e": "node dist/apps/api/main.js",
    "start:web:e2e": "next start apps/web -p 3100",
    "bootstrap:admin": "node -e \"const fs=require('node:fs');const paths=['dist/bootstrap/admin.js','dist/apps/api/bootstrap/admin.js'];const target=paths.find((path)=>fs.existsSync(path));if(!target){console.error('Build API before running bootstrap:admin.');process.exit(1);}process.argv.splice(1,0,target);require('./'+target);\" --",
    "dev:web": "next dev apps/web",
    "test:api": "vitest run --dir apps/api/src",
    "test:web": "vitest run --dir apps/web/src",
    "test:e2e": "node scripts/e2e-check.mjs",
    "test:smoke": "node scripts/smoke-check.mjs",
    "readiness:check": "node scripts/readiness-check.mjs",
    "deploy:verify": "node scripts/deployment-verify.mjs",
    "verify:ledger": "node scripts/verify-ledger-guards.mjs",
    "typecheck:web": "tsc -p apps/web/tsconfig.json --noEmit",
    "prisma:generate": "node scripts/run-prisma-schema-command.mjs generate",
    "prisma:validate": "node scripts/run-prisma-schema-command.mjs validate",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:push:e2e": "prisma db push --schema prisma/schema.prisma --skip-generate",
    "scan:imports": "node scripts/check-import-cycles.mjs",
    "infra:check": "node scripts/check-production-infra.mjs",
    "docker:config:prod": "docker compose -f compose.prod.yaml --env-file env.example config"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@nestjs/common": "11.1.23",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.23",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "11.1.23",
    "@nestjs/swagger": "11.4.4",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@tanstack/react-query": "5.100.14",
    "bcrypt": "^6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "prisma": "6.19.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.76.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.23",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "10.4.0",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.15",
    "tailwindcss": "4.3.0",
    "tailwindcss-animate": "1.0.7",
    "typescript": "6.0.3",
    "vitest": "^4.0.14"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
