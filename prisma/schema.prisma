  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([cashAccountId, ledgerSequence])
  @@index([rtId, cashAccountId, ledgerDate, id])
  @@index([rtId, ledgerDate])
  @@map("cash_ledgers")
}

