model Transaction {
  id                 String            @id @default(uuid()) @db.Uuid
  rtId               String            @map("rt_id") @db.Uuid
  cashAccountId      String            @map("cash_account_id") @db.Uuid
  categoryId         String            @map("category_id") @db.Uuid
  sourceCollectionId String?           @map("source_collection_id") @db.Uuid
  referenceNumber    String?           @map("reference_number") @db.VarChar(80)
  idempotencyKey     String?           @map("idempotency_key") @db.VarChar(120)
  externalRef        String?           @map("external_ref") @db.VarChar(120)
  type               TransactionType
  status             TransactionStatus @default(DRAFT)
  amount             Decimal           @db.Decimal(14, 2)
  description        String
  transactionDate    DateTime          @map("transaction_date") @db.Date
  createdById        String            @map("created_by_id") @db.Uuid
  updatedById        String?           @map("updated_by_id") @db.Uuid
  validatedById      String?           @map("validated_by_id") @db.Uuid
  validatedAt        DateTime?         @map("validated_at") @db.Timestamptz(6)
  validationNote     String?           @map("validation_note")
  rejectedById       String?           @map("rejected_by_id") @db.Uuid
  rejectedAt         DateTime?         @map("rejected_at") @db.Timestamptz(6)
  rejectionReason    String?           @map("rejection_reason")
  postedById         String?           @map("posted_by_id") @db.Uuid
  postedAt           DateTime?         @map("posted_at") @db.Timestamptz(6)
  voidedById         String?           @map("voided_by_id") @db.Uuid
  voidedAt           DateTime?         @map("voided_at") @db.Timestamptz(6)
  deletedById        String?           @map("deleted_by_id") @db.Uuid
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  rt               Rt                  @relation(fields: [rtId], references: [id], onDelete: Restrict)
  cashAccount      CashAccount         @relation(fields: [cashAccountId], references: [id], onDelete: Restrict)
  category         TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sourceCollection JimpitanCollection? @relation(fields: [sourceCollectionId], references: [id], onDelete: SetNull)
  createdBy        User                @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy        User?               @relation("TransactionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  validatedBy      User?               @relation("TransactionValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)
  rejectedBy       User?               @relation("TransactionRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  postedBy         User?               @relation("TransactionPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  voidedBy         User?               @relation("TransactionVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  ledger           CashLedger?
  approvals        ExpenseApproval[]
  attachments      Attachment[]

  @@unique([rtId, referenceNumber])
  @@unique([rtId, idempotencyKey])
  @@unique([rtId, externalRef])
  @@unique([sourceCollectionId])
  @@index([rtId, transactionDate, type])
  @@index([rtId, status])
  @@index([rtId, categoryId, transactionDate])
  @@index([rtId, cashAccountId, transactionDate])
  @@index([rtId, sourceCollectionId])
  @@index([rtId, deletedAt])
  @@map("transactions")
}

model CashLedger {
  id             String          @id @default(uuid()) @db.Uuid
  rtId           String          @map("rt_id") @db.Uuid
  cashAccountId  String          @map("cash_account_id") @db.Uuid
  transactionId  String          @unique @map("transaction_id") @db.Uuid
